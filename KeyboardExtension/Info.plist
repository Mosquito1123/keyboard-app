<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>键盘项目</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!--
	    RequestsOpenAccess is what makes Settings show Allow Full Access.
	    The microphone is used only after that switch is on, demo mode is off,
	    and the user taps the mic. Recognition is on-device. Apple still does
	    not guarantee that a keyboard extension can open the microphone.
	-->
	<key>KeyboardAppGroupEnabled</key>
	<string>$(KEYBOARD_APP_GROUP_ENABLED)</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>键盘项目的键盘只在你点按麦克风且已允许完全访问时录音，用于本机听写，不会上传，也不会保存录音。The 键盘项目 keyboard records only when you tap the mic and Allow Full Access is on, for on-device dictation. Audio is not uploaded or stored.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>键盘项目的键盘使用苹果的设备端语音识别把语音转成文字并插入当前输入框。识别留在本机；若本机识别不可用，不会改走云端。The 键盘项目 keyboard uses Apple on-device speech recognition to insert text in the current field. It stays on this device and does not fall back to a server.</string>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionAttributes</key>
		<dict>
			<key>IsASCIICapable</key>
			<true/>
			<key>PrefersRightToLeft</key>
			<false/>
			<key>PrimaryLanguage</key>
			<string>zh-Hans</string>
			<key>RequestsOpenAccess</key>
			<true/>
		</dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.keyboard-service</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).KeyboardViewController</string>
	</dict>
</dict>
</plist>
