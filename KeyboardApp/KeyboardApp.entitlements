<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	    App Group shared with the keyboard extension.
	    Register group.com.mosquito1123.keyboardapp for your Team, then point
	    CODE_SIGN_ENTITLEMENTS at this file and set KEYBOARD_APP_GROUP_ENABLED
	    to YES. The default signing file omits the group so a free Personal
	    Team can still install. See the README.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.mosquito1123.keyboardapp</string>
	</array>
</dict>
</plist>
